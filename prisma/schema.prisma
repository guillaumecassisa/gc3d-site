// =============================================================================
// GC3D — Modèle de données
// -----------------------------------------------------------------------------
// Conventions :
//  * Montants en centimes (Int) + devise ISO 4217 : aucune erreur de virgule flottante.
//  * Taux de TVA en points de base (Int) : 2000 = 20,00 %.
//  * Dimensions en millimètres, poids en grammes.
//  * Les documents commerciaux (commandes, devis, factures) stockent des
//    instantanés (snapshots) : modifier un produit ne réécrit jamais l'historique.
//  * Les tables d'authentification (User/Session/Account/Verification) suivent
//    le format attendu par Better Auth.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// IDENTITÉ & UTILISATEURS
// =============================================================================

/// Rôles applicatifs. Les permissions associées sont définies dans
/// src/lib/permissions (versionnées avec le code, testées unitairement).
enum UserRole {
  OWNER // Administrateur principal
  SHOP_MANAGER // Gestionnaire boutique
  PRODUCTION_OPERATOR // Opérateur de fabrication
  SUPPORT // Support client
  CUSTOMER // Client
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          UserRole     @default(CUSTOMER)
  banned        Boolean      @default(false)
  banReason     String?
  banExpires    DateTime?
  firstName     String?
  lastName      String?
  phone         String?
  customerType  CustomerType @default(INDIVIDUAL)
  marketingOptIn Boolean     @default(false)
  /// Anonymisation RGPD : les données commerciales restent (obligations
  /// comptables), l'identité est effacée.
  anonymizedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions        Session[]
  accounts        Account[]
  company         CompanyProfile?
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  quoteRequests   QuoteRequest[]
  quotes          Quote[]
  favorites       Favorite[]
  reviews         Review[]
  notifications   Notification[]
  uploadedFiles   UploadedFile[]
  auditLogs       AuditLog[]
  dataRequests    DataRequest[]
  assignedJobs    ProductionJob[] @relation("JobAssignee")
  couponRedemptions CouponRedemption[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Limitation de débit persistée (Better Auth + routes sensibles).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName        String
  siret            String?
  vatNumber        String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  /// Accès aux tarifs B2B soumis à validation administrateur.
  status           CompanyStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedById     String?
  /// Remise B2B en points de base, appliquée seulement si APPROVED.
  discountBps      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

model Address {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              AddressType @default(BOTH)
  label             String?
  firstName         String
  lastName          String
  company           String?
  line1             String
  line2             String?
  postalCode        String
  city              String
  /// Code pays ISO 3166-1 alpha-2.
  country           String      @default("FR")
  phone             String?
  isDefaultShipping Boolean     @default(false)
  isDefaultBilling  Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
}

// =============================================================================
// CATALOGUE
// =============================================================================

/// Technologie / atelier (gravure laser, découpe laser, UV, 3D...).
/// Table et non enum : on peut ajouter une machine ou technologie sans migration.
model Technology {
  id          String   @id @default(cuid())
  code        String   @unique // LASER_ENGRAVING, LASER_CUTTING, UV_PRINTING, PRINTING_3D
  slug        String   @unique
  name        String
  shortName   String
  description String?
  imageUrl    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories      Category[]
  products        Product[]
  materials       MaterialTechnology[]
  quoteRequests   QuoteRequest[]
  productionJobs  ProductionJob[]
  portfolio       PortfolioProject[]
}

enum CategoryStatus {
  VISIBLE
  HIDDEN
  ARCHIVED
}

model Category {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  description    String?
  imageUrl       String?
  position       Int            @default(0)
  status         CategoryStatus @default(VISIBLE)
  technologyId   String?
  technology     Technology?    @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]     @relation("CategoryTree")
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products   Product[]
  faqs       Faq[]
  pricingRules PricingRule[]

  @@index([technologyId, status, position])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum SaleMode {
  STANDARD // Achat direct
  CUSTOMIZABLE // Achat après configuration
  QUOTE_ONLY // Sur devis
}

model Product {
  id                  String        @id @default(cuid())
  sku                 String        @unique
  slug                String        @unique
  name                String
  status              ProductStatus @default(DRAFT)
  saleMode            SaleMode      @default(STANDARD)
  technologyId        String
  technology          Technology    @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription    String?
  description         String?
  /// Prix de base TTC (ou net si franchise de TVA) en centimes.
  basePriceCents      Int
  /// Prix barré (avant promotion) éventuel.
  compareAtPriceCents Int?
  currency            String        @default("EUR")
  /// Taux de TVA spécifique ; null = taux par défaut des paramètres.
  taxRateBps          Int?
  colorsLabel         String?
  widthMm             Int?
  heightMm            Int?
  depthMm             Int?
  weightGrams         Int?
  productionDaysMin   Int?
  productionDaysMax   Int?
  shippingDaysMin     Int?
  shippingDaysMax     Int?
  trackInventory      Boolean       @default(false)
  madeToOrder         Boolean       @default(true)
  /// Exception au droit de rétractation (art. L221-28 3° C. conso) — par produit, jamais globale.
  withdrawalExempt    Boolean       @default(false)
  featured            Boolean       @default(false)
  position            Int           @default(0)
  /// Produit de démonstration : jamais affiché en production.
  isDemo              Boolean       @default(false)
  seoTitle            String?
  seoDescription      String?
  ogImageUrl          String?
  /// Champ de recherche normalisé (nom + description + SKU, sans accents).
  searchText          String        @default("")
  salesCount          Int           @default(0)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  images        ProductImage[]
  videos        ProductVideo[]
  variants      ProductVariant[]
  options       ProductOption[]
  materials     ProductMaterial[]
  collections   ProductCollection[]
  pricingRules  PricingRule[]
  inventory     Inventory[]
  relatedFrom   RelatedProduct[] @relation("RelatedFrom")
  relatedTo     RelatedProduct[] @relation("RelatedTo")
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  favorites     Favorite[]
  faqs          Faq[]

  @@index([status, isDemo, technologyId])
  @@index([categoryId, status, position])
  @@index([featured, status])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  width     Int?
  height    Int?
  position  Int      @default(0)
  variantId String?
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductVideo {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  posterUrl String?
  title     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String   @unique
  name           String
  /// Prix absolu de la variante ; null = prix de base du produit.
  priceCents     Int?
  weightGrams    Int?
  active         Boolean  @default(true)
  position       Int      @default(0)
  /// Combinaison d'options : { [optionCode]: valueCode }
  optionValues   Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, active])
}

enum ProductOptionType {
  SELECT // Liste de choix
  COLOR // Pastilles de couleur
  MATERIAL // Choix de matériau
  SIZE // Dimension
  FINISH // Finition
  TEXT // Texte court (prénom...)
  TEXTAREA // Message
  FONT // Choix de police
  FILE // Import logo / image / vectoriel
  NUMBER
  CHECKBOX // Option supplémentaire
}

model ProductOption {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  label     String
  helpText  String?
  type      ProductOptionType
  required  Boolean           @default(false)
  position  Int               @default(0)
  /// Contraintes : maxLength, min/max, formats de fichiers, zone de
  /// personnalisation (x,y,w,h en mm), polices autorisées...
  config    Json              @default("{}")
  /// Supplément fixe lorsqu'un champ libre (texte/fichier/case) est renseigné.
  priceDeltaCents Int         @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  values ProductOptionValue[]

  @@unique([productId, code])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  optionId        String
  option          ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  code            String
  label           String
  priceDeltaCents Int           @default(0)
  swatchHex       String?
  materialId      String?
  material        Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  position        Int           @default(0)
  active          Boolean       @default(true)

  @@unique([optionId, code])
}

model Material {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Épaisseurs disponibles (mm) pour les matériaux en plaque.
  thicknessesMm Json   @default("[]")
  colors      Json     @default("[]")
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technologies MaterialTechnology[]
  products     ProductMaterial[]
  optionValues ProductOptionValue[]
}

model MaterialTechnology {
  materialId   String
  technologyId String
  material     Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([materialId, technologyId])
}

model ProductMaterial {
  productId  String
  materialId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([productId, materialId])
}

model RelatedProduct {
  fromId   String
  toId     String
  position Int     @default(0)
  from     Product @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       Product @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

enum PricingRuleType {
  QUANTITY_TIER // Dégressif selon quantité
  PER_CHARACTER // Prix par caractère au-delà d'un seuil
  PER_AREA // Prix par cm² (surface)
  OPTION_SURCHARGE // Supplément conditionnel (combinaison d'options)
  FIXED_FEE // Frais fixes (mise en route...)
  PERCENT_ADJUSTMENT // Majoration / remise en %
  B2B_DISCOUNT
}

/// Moteur de règles tarifaires administrables. Chaque règle a une portée
/// (produit, catégorie ou globale), une priorité et des conditions JSON
/// validées par Zod (src/features/pricing/rules.ts).
model PricingRule {
  id          String          @id @default(cuid())
  name        String
  type        PricingRuleType
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority    Int             @default(100)
  params      Json
  active      Boolean         @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([productId, active])
  @@index([categoryId, active])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// null = stock au niveau produit
  variantId         String?  @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(2)
  updatedAt         DateTime @updatedAt

  movements InventoryMovement[]

  @@index([productId])
}

enum InventoryMovementType {
  RECEIPT // Entrée
  ADJUSTMENT // Ajustement manuel
  RESERVATION // Réservation (paiement en cours)
  RELEASE // Libération (paiement échoué / expiré)
  SALE // Sortie définitive (paiement confirmé)
  RETURN
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  quantity    Int
  reason      String?
  orderId     String?
  actorId     String?
  createdAt   DateTime              @default(now())

  @@index([inventoryId, createdAt])
  @@index([orderId])
}

// =============================================================================
// COMMERCE
// =============================================================================

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Empreinte SHA-256 du jeton invité (le jeton brut n'est stocké que dans un cookie HttpOnly).
  guestTokenHash String?    @unique
  couponCode     String?
  currency       String     @default("EUR")
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]

  @@index([expiresAt])
}

model CartItem {
  id                String          @id @default(cuid())
  cartId            String
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int
  /// Configuration client validée (texte, police, options, fichiers...).
  configuration     Json            @default("{}")
  /// Hash de configuration : deux lignes identiques fusionnent.
  configurationHash String
  previewFileId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([cartId, productId, variantId, configurationHash])
}

enum CouponType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  description        String?
  type               CouponType
  /// PERCENT : points de base ; FIXED_AMOUNT : centimes.
  value              Int
  minSubtotalCents   Int?
  maxRedemptions     Int?
  perCustomerLimit   Int?
  redemptionCount    Int        @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean    @default(true)
  b2bOnly            Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  createdAt DateTime @default(now())

  @@index([couponId])
}

/// Statut global de la commande (vue client).
enum OrderStatus {
  PENDING_PAYMENT // En attente de paiement
  PAID // Payée
  IN_PREPARATION // En préparation
  IN_PRODUCTION // En fabrication
  QUALITY_CHECK // Contrôle qualité
  READY_TO_SHIP // Prête à expédier
  SHIPPED // Expédiée
  DELIVERED // Livrée
  CANCELLED // Annulée
  DISPUTED // Litige
  REFUNDED // Remboursée
}

/// Statut de paiement — distinct de l'avancement de fabrication.
enum PaymentStatus {
  UNPAID
  PROCESSING // Paiement en cours (état intermédiaire)
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  RETURNED
}

enum VatMode {
  FRANCHISE // TVA non applicable, art. 293 B du CGI
  STANDARD // TVA collectée
}

model Order {
  id                String            @id @default(cuid())
  number            String            @unique // CMD-2026-00001
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String
  isGuest           Boolean           @default(false)
  /// Jeton d'accès invité (empreinte) pour le suivi sans compte.
  accessTokenHash   String?           @unique
  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("EUR")
  subtotalCents     Int
  discountCents     Int               @default(0)
  shippingCents     Int               @default(0)
  taxCents          Int               @default(0)
  totalCents        Int
  vatMode           VatMode
  vatMention        String?
  shippingAddress   Json?
  billingAddress    Json
  shippingMethodId  String?
  shippingMethod    Json?
  couponCode        String?
  customerNote      String?
  internalNote      String?
  quoteId           String?           @unique
  quote             Quote?            @relation("QuoteOrder", fields: [quoteId], references: [id], onDelete: SetNull)
  /// Expiration de la réservation de stock si le paiement n'aboutit pas.
  reservationExpiresAt DateTime?
  placedAt          DateTime          @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  refunds          Refund[]
  shipments        Shipment[]
  invoices         Invoice[]
  productionJobs   ProductionJob[]
  couponRedemption CouponRedemption?
  reviews          Review[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([email])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  variantName    String?
  technologyCode String
  imageUrl       String?
  quantity       Int
  unitPriceCents Int
  discountCents  Int             @default(0)
  taxRateBps     Int             @default(0)
  taxCents       Int             @default(0)
  totalCents     Int
  withdrawalExempt Boolean       @default(false)
  createdAt      DateTime        @default(now())

  customization  OrderItemCustomization?
  productionJobs ProductionJob[]

  @@index([orderId])
  @@index([productId])
}

/// Configuration historique figée d'une ligne personnalisée.
model OrderItemCustomization {
  id             String    @id @default(cuid())
  orderItemId    String    @unique
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// { fields: { code: { label, value, display } }, layout: {...} }
  configuration  Json
  /// Détail des règles tarifaires appliquées (traçabilité du prix).
  appliedRules   Json      @default("[]")
  previewFileId  String?
  createdAt      DateTime  @default(now())

  files UploadedFile[]
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  PAYMENT_STATUS_CHANGED
  NOTE_ADDED
  EMAIL_SENT
  SHIPMENT_CREATED
  REFUND_CREATED
  INVOICE_ISSUED
}

model OrderEvent {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       OrderEventType
  fromStatus String?
  toStatus   String?
  message    String?
  /// Visible par le client (frise de suivi) ?
  visibleToCustomer Boolean @default(false)
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  STRIPE
  MANUAL // Virement, encaissement hors ligne saisi par un admin
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  /// Identifiant chez le prestataire (Checkout Session / PaymentIntent).
  providerRef       String
  providerPaymentIntentId String?
  status            PaymentStatus   @default(PROCESSING)
  amountCents       Int
  currency          String
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerRef String?      @unique
  amountCents Int
  reason      String?
  status      RefundStatus @default(PENDING)
  actorId     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orderId])
}

/// Idempotence des webhooks : un évènement n'est traité qu'une fois.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ----------------------------------------------------------------------------- Livraison

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  /// Codes pays ISO + éventuels préfixes de codes postaux exclus (ex: Corse "20").
  countries Json     @default("[\"FR\"]")
  excludedPostalPrefixes Json @default("[]")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]
}

enum ShippingMethodType {
  HOME_DELIVERY
  RELAY_POINT // Uniquement si un transporteur compatible est intégré
  LOCAL_PICKUP // Uniquement si une adresse réelle est configurée
  ON_QUOTE
}

enum ShippingPricingType {
  FLAT
  BY_WEIGHT
  FREE
}

model ShippingMethod {
  id              String              @id @default(cuid())
  zoneId          String
  zone            ShippingZone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  type            ShippingMethodType
  pricingType     ShippingPricingType @default(FLAT)
  flatPriceCents  Int                 @default(0)
  /// Livraison offerte à partir de ce sous-total (null = jamais).
  freeOverCents   Int?
  bulkySurchargeCents Int             @default(0)
  carrier         String?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  /// Méthode exigeant une intégration (point relais) : bloquée tant que non intégrée.
  requiresIntegration Boolean         @default(false)
  active          Boolean             @default(false)
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  weightRates ShippingRate[]
}

model ShippingRate {
  id             String         @id @default(cuid())
  methodId       String
  method         ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  maxWeightGrams Int
  priceCents     Int

  @@unique([methodId, maxWeightGrams])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  /// Lignes expédiées : [{ orderItemId, quantity }]
  items          Json           @default("[]")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events ShipmentEvent[]

  @@index([orderId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  message    String?
  occurredAt DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

// ----------------------------------------------------------------------------- Facturation

enum InvoiceType {
  INVOICE
  CREDIT_NOTE // Avoir
}

/// Factures : numérotation continue, chronologique, sans trou, et immuables
/// une fois émises. Toute correction passe par un avoir.
model Invoice {
  id               String      @id @default(cuid())
  number           String      @unique // FA-2026-00001 / AV-2026-00001
  type             InvoiceType @default(INVOICE)
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  correctsId       String?
  corrects         Invoice?    @relation("InvoiceCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections      Invoice[]   @relation("InvoiceCorrection")
  issuedAt         DateTime    @default(now())
  sellerSnapshot   Json
  buyerSnapshot    Json
  lines            Json
  currency         String
  subtotalCents    Int
  discountCents    Int
  shippingCents    Int
  taxCents         Int
  totalCents       Int
  vatMode          VatMode
  vatMention       String?
  pdfFileId        String?
  createdAt        DateTime    @default(now())

  @@index([orderId])
}

/// Compteurs de numérotation (verrouillés en transaction).
model DocumentSequence {
  key       String   @id // "order:2026", "quote:2026", "invoice:2026", "credit:2026"
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

// =============================================================================
// DEVIS
// =============================================================================

enum QuoteRequestSource {
  GENERIC
  PRINTING_3D
  LASER_ENGRAVING
  LASER_CUTTING
  UV_PRINTING
  PRODUCT // Produit "sur devis" du catalogue
}

enum QuoteRequestStatus {
  NEW
  IN_REVIEW
  WAITING_CUSTOMER // Infos manquantes
  QUOTED
  CLOSED
  SPAM
}

model QuoteRequest {
  id               String             @id @default(cuid())
  reference        String             @unique // DDE-2026-0001
  source           QuoteRequestSource @default(GENERIC)
  status           QuoteRequestStatus @default(NEW)
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  email            String
  phone            String?
  company          String?
  technologyId     String?
  technology       Technology?        @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  productId        String?
  description      String
  material         String?
  dimensions       String?
  quantity         Int                @default(1)
  desiredDate      DateTime?
  shippingPostalCode String?
  shippingCity     String?
  shippingCountry  String?
  /// Champs propres au module (épaisseur, finition, qualité, analyse 3D indicative...).
  details          Json               @default("{}")
  internalNotes    String?
  consentAt        DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  files  UploadedFile[]
  quotes Quote[]

  @@index([status, createdAt])
  @@index([email])
}

enum QuoteStatus {
  DRAFT // Brouillon
  SENT // Envoyé
  AWAITING_RESPONSE // En attente de réponse (consulté)
  ACCEPTED // Accepté
  REJECTED // Refusé
  EXPIRED // Expiré
  CANCELLED // Annulé
}

model Quote {
  id               String       @id @default(cuid())
  reference        String       @unique // DEV-2026-0001
  requestId        String?
  request          QuoteRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  customerName     String
  companyName      String?
  status           QuoteStatus  @default(DRAFT)
  currentVersion   Int          @default(1)
  acceptedVersion  Int?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  accessTokenHash  String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  versions QuoteVersion[]
  events   QuoteEvent[]
  /// Conversion unique : @unique sur Order.quoteId empêche les doublons.
  order    Order?       @relation("QuoteOrder")

  @@index([status, createdAt])
  @@index([userId])
}

model QuoteVersion {
  id            String    @id @default(cuid())
  quoteId       String
  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version       Int
  /// Une version envoyée est figée (lecture seule).
  sentAt        DateTime?
  validUntil    DateTime?
  currency      String    @default("EUR")
  subtotalCents Int       @default(0)
  discountCents Int       @default(0)
  shippingCents Int       @default(0)
  taxCents      Int       @default(0)
  totalCents    Int       @default(0)
  vatMode       VatMode
  vatMention    String?
  conditions    String?
  customerMessage String?
  productionDays Int?
  pdfFileId     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items QuoteItem[]

  @@unique([quoteId, version])
}

model QuoteItem {
  id             String       @id @default(cuid())
  versionId      String
  version        QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  label          String
  description    String?
  technologyCode String?
  quantity       Int
  unitPriceCents Int
  taxRateBps     Int          @default(0)
  totalCents     Int
  position       Int          @default(0)

  @@index([versionId, position])
}

enum QuoteEventType {
  CREATED
  VERSION_CREATED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED
  NOTE_ADDED
  PAID
}

model QuoteEvent {
  id        String         @id @default(cuid())
  quoteId   String
  quote     Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type      QuoteEventType
  version   Int?
  message   String?
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([quoteId, createdAt])
}

// =============================================================================
// FABRICATION
// =============================================================================

enum ProductionStatus {
  TO_PREPARE // À préparer
  FILE_CHECK // Fichier à vérifier
  AWAITING_CUSTOMER // En attente de validation client
  READY // Prêt pour fabrication
  IN_PROGRESS // En cours
  PAUSED // En pause
  TO_CHECK // À contrôler
  DONE // Terminé
  BLOCKED // Bloqué
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProductionJob {
  id            String             @id @default(cuid())
  reference     String             @unique // FAB-2026-00001
  orderId       String
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String?
  orderItem     OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  technologyId  String
  technology    Technology         @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  status        ProductionStatus   @default(TO_PREPARE)
  priority      ProductionPriority @default(NORMAL)
  quantity      Int
  dueDate       DateTime?
  assigneeId    String?
  assignee      User?              @relation("JobAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Instantané : produit, configuration client, matériau, couleur, dimensions, instructions.
  specs         Json
  startedAt     DateTime?
  completedAt   DateTime?
  checkedAt     DateTime?
  checkedById   String?
  blockedReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tasks  ProductionTask[]
  events ProductionEvent[]
  notes  ProductionNote[]
  files  UploadedFile[]

  @@index([status, priority, dueDate])
  @@index([technologyId, status])
  @@index([orderId])
}

model ProductionTask {
  id        String        @id @default(cuid())
  jobId     String
  job       ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean       @default(false)
  doneAt    DateTime?
  doneById  String?
  position  Int           @default(0)

  @@index([jobId, position])
}

enum ProductionEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  ISSUE_REPORTED
  CHECKED
  NOTE_ADDED
}

model ProductionEvent {
  id         String              @id @default(cuid())
  jobId      String
  job        ProductionJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       ProductionEventType
  fromStatus ProductionStatus?
  toStatus   ProductionStatus?
  message    String?
  actorId    String?
  createdAt  DateTime            @default(now())

  @@index([jobId, createdAt])
}

model ProductionNote {
  id        String        @id @default(cuid())
  jobId     String
  job       ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  createdAt DateTime      @default(now())

  @@index([jobId])
}

// =============================================================================
// FICHIERS
// =============================================================================

enum FileVisibility {
  PRIVATE // Bucket privé, accès par URL signée temporaire uniquement
  PUBLIC // CDN (visuels produits, réalisations)
}

enum FileKind {
  CUSTOMER_UPLOAD
  CUSTOMIZATION_PREVIEW
  PRODUCTION
  DOCUMENT // PDF devis, facture, bon de livraison
  PRODUCT_MEDIA
  PORTFOLIO_MEDIA
  CONTACT_ATTACHMENT
}

enum FileStatus {
  PENDING // Téléversement initié
  READY
  REJECTED // Type réel non conforme
  QUARANTINED // Antivirus positif
  DELETED
}

model UploadedFile {
  id             String         @id @default(cuid())
  /// Nom interne aléatoire (jamais le nom client).
  storageKey     String         @unique
  visibility     FileVisibility @default(PRIVATE)
  kind           FileKind
  status         FileStatus     @default(PENDING)
  originalName   String
  /// Type MIME détecté côté serveur (signature binaire), pas celui du navigateur.
  mimeType       String
  extension      String
  sizeBytes      Int
  sha256         String?
  scanStatus     String?
  /// Métadonnées : dimensions image, DPI, bbox/volume 3D indicatifs...
  meta           Json           @default("{}")
  ownerUserId    String?
  owner          User?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// Empreinte du jeton invité propriétaire (panier invité).
  ownerGuestHash String?
  customizationId String?
  customization  OrderItemCustomization? @relation(fields: [customizationId], references: [id], onDelete: SetNull)
  quoteRequestId String?
  quoteRequest   QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  productionJobId String?
  productionJob  ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  contactMessageId String?
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  accesses FileAccess[]

  @@index([ownerUserId])
  @@index([quoteRequestId])
  @@index([customizationId])
  @@index([status, createdAt])
}

/// Journal d'accès aux fichiers privés.
model FileAccess {
  id        String       @id @default(cuid())
  fileId    String
  file      UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String?
  action    String // DOWNLOAD, PREVIEW, DELETE
  createdAt DateTime     @default(now())

  @@index([fileId, createdAt])
}

// =============================================================================
// CONTENUS
// =============================================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Achat vérifié : avis lié à une commande payée contenant le produit.
  verifiedPurchase Boolean      @default(false)
  authorName       String
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId, orderId])
  @@index([productId, status])
  @@index([status, createdAt])
}

model PortfolioProject {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  description    String?
  technologyId   String?
  technology     Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  categoryLabel  String?
  fabricationInfo String?
  completedOn    DateTime?
  /// Publication interdite sans autorisation explicite du client concerné.
  clientConsent  Boolean     @default(false)
  published      Boolean     @default(false)
  position       Int         @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  images PortfolioImage[]

  @@index([published, position])
}

model PortfolioImage {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  width     Int?
  height    Int?
  position  Int              @default(0)
}

enum FaqScope {
  GLOBAL
  CATEGORY
  PRODUCT
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String
  scope      FaqScope @default(GLOBAL)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  showOnHome Boolean  @default(false)
  position   Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, published, position])
}

enum SitePageType {
  LEGAL
  INFO
  SEO_LANDING
}

model SitePage {
  id               String       @id @default(cuid())
  slug             String       @unique
  type             SitePageType @default(INFO)
  title            String
  /// Contenu Markdown.
  content          String
  published        Boolean      @default(false)
  /// Les textes juridiques doivent être validés avant publication.
  legalValidatedAt DateTime?
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  updatedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

enum BannerPlacement {
  HOME_HERO
  HOME_SECONDARY
  ANNOUNCEMENT_BAR
  CATEGORY
}

model Banner {
  id          String          @id @default(cuid())
  placement   BannerPlacement
  title       String
  subtitle    String?
  imageUrl    String?
  ctaLabel    String?
  ctaHref     String?
  position    Int             @default(0)
  active      Boolean         @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, active, position])
}

/// Paramètres administrables (clé / valeur JSON validée par Zod côté serveur).
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Redirections SEO administrables.
model Redirect {
  id          String   @id @default(cuid())
  fromPath    String   @unique
  toPath      String
  permanent   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

enum NewsletterStatus {
  PENDING // Double opt-in en attente
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         NewsletterStatus @default(PENDING)
  consentText    String
  consentAt      DateTime
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// =============================================================================
// COMMUNICATION
// =============================================================================

enum ContactStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  userId    String?
  ipHash    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  files UploadedFile[]

  @@index([status, createdAt])
}

enum NotificationAudience {
  STAFF
  CUSTOMER
}

model Notification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  /// Destinataire précis ; null + STAFF = tout le personnel autorisé.
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ORDER_CREATED, QUOTE_REQUESTED, PAYMENT_FAILED, FILE_RECEIVED, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([audience, readAt, createdAt])
  @@index([userId, readAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED // Fournisseur non configuré
}

model EmailLog {
  id          String      @id @default(cuid())
  to          String
  template    String
  subject     String
  status      EmailStatus @default(QUEUED)
  providerId  String?
  error       String?
  attempts    Int         @default(0)
  relatedType String?
  relatedId   String?
  /// Clé d'idempotence (ex: "order-confirmation:<orderId>").
  dedupeKey   String?     @unique
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([relatedType, relatedId])
}

// =============================================================================
// SÉCURITÉ & CONFORMITÉ
// =============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // product.update, order.status_change, refund.create...
  entityType String
  entityId   String?
  /// Données non sensibles uniquement (diff synthétique).
  data       Json     @default("{}")
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Preuve du consentement cookies (CNIL).
model ConsentRecord {
  id          String   @id @default(cuid())
  /// Identifiant anonyme stocké dans le cookie de consentement.
  subjectId   String
  userId      String?
  categories  Json // { necessary: true, analytics: false, marketing: false }
  policyVersion String
  action      String // ACCEPT_ALL, REJECT_ALL, CUSTOM, WITHDRAW
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([subjectId, createdAt])
}

enum DataRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  PORTABILITY
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  type        DataRequestType
  status      DataRequestStatus @default(OPEN)
  details     String?
  response    String?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

/// Évènements métier (analytics serveur, sans double comptage).
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String // product_view, add_to_cart, begin_checkout, purchase, quote_request
  dedupeKey  String?  @unique
  sessionId  String?
  userId     String?
  productId  String?
  orderId    String?
  valueCents Int?
  props      Json     @default("{}")
  createdAt  DateTime @default(now())

