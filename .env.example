# =============================================================================
# GC3D — variables d'environnement
# Copier en .env (développement) ; en production, les définir chez l'hébergeur.
# Ne JAMAIS committer de vraies valeurs. Aucune de ces variables n'est exposée
# au navigateur (pas de préfixe NEXT_PUBLIC_ sauf mention).
# =============================================================================

# --- Application --------------------------------------------------------------
# URL publique du site (sans / final). Sert aux liens d'e-mails et à l'auth.
APP_URL="http://localhost:3000"

# --- Base de données (PostgreSQL 15+) -----------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gc3d"

# --- Authentification ---------------------------------------------------------
# Secret aléatoire de 32+ caractères :  openssl rand -base64 48
BETTER_AUTH_SECRET=""

# Sel de hachage des adresses IP (journaux, anti-spam) : openssl rand -hex 24
IP_HASH_SALT=""

# Compte administrateur principal créé par `npm run db:seed` (facultatif)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Guillaume"

# --- Paiement : Stripe (phase 3) ----------------------------------------------
# Clés TEST (sk_test_…) en développement et préproduction.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Clé publique (seule variable destinée au navigateur)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Stockage compatible S3 (Cloudflare R2, Scaleway, OVH, AWS…) ---------------
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Bucket PRIVÉ : fichiers clients, documents de fabrication, factures
STORAGE_PRIVATE_BUCKET=""
# Bucket PUBLIC / CDN : visuels produits et réalisations
STORAGE_PUBLIC_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""

# --- E-mails transactionnels : Resend -----------------------------------------
RESEND_API_KEY=""
# Expéditeur sur un domaine vérifié chez Resend, ex. "GC3D <commandes@votre-domaine.fr>"
EMAIL_FROM=""
# Destinataire des alertes internes (nouveau message, commande, devis…)
STAFF_NOTIFICATION_EMAIL=""

# Schéma PostgreSQL (ex. "gc3d" pour isoler l'application dans une base partagée)
DATABASE_SCHEMA="public"
DATABASE_POOL_MAX="5"
